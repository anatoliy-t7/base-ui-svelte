{
	"$schema": "../../node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "none",
	"printWidth": 100,
	"embeddedLanguageFormatting": "auto",
	"svelte": true,
	"sortTailwindcss": {
		"stylesheet": "./src/app.css",
		"functions": ["clsx", "cn"],
		"preserveWhitespace": false
	},
	"ignorePatterns": [".svelte-kit/**", "build/**", "dist/**"]
}
