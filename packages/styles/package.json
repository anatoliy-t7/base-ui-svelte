{
	"name": "@base-ui-svelte/styles",
	"version": "0.1.0",
	"description": "CSS and TypeScript style recipes for base-ui-svelte",
	"license": "MIT",
	"type": "module",
	"style": "./index.css",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"style": "./index.css",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./css": {
			"style": "./index.css",
			"default": "./index.css"
		},
		"./components/*": "./components/*",
		"./themes/*": "./themes/*",
		"./package.json": "./package.json"
	},
	"sideEffects": ["*.css"],
	"files": ["dist", "index.css", "base", "components", "themes", "utilities", "variants"],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependencies": {
		"tailwindcss": ">=4.0.0"
	},
	"devDependencies": {
		"tailwindcss": "^4.1.0",
		"typescript": "^5.9.3"
	},
	"keywords": ["base-ui-svelte", "css", "tailwind", "styles", "design-system"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anatoliy-t7/base-ui-svelte.git",
		"directory": "packages/styles"
	}
}
