{
	"name": "@base-ui-svelte/styles",
	"version": "0.1.0",
	"description": "CSS and TypeScript style recipes for base-ui-svelte",
	"keywords": [
		"base-ui-svelte",
		"css",
		"design-system",
		"styles",
		"tailwind"
	],
	"homepage": "https://github.com/anatoliy-t7/base-ui-svelte/tree/main/packages/styles#readme",
	"bugs": {
		"url": "https://github.com/anatoliy-t7/base-ui-svelte/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anatoliy-t7/base-ui-svelte.git",
		"directory": "packages/styles"
	},
	"style": "./index.css",
	"files": [
		"dist",
		"index.css",
		"base",
		"components",
		"themes",
		"utilities",
		"variants"
	],
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"style": "./index.css",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./css": {
			"style": "./index.css",
			"default": "./index.css"
		},
		"./components/*": "./components/*",
		"./themes/*": "./themes/*",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"clean": "rm -rf dist",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"prepublishOnly": "bun run build && bun run publint",
		"publint": "publint"
	},
	"dependencies": {
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"publint": "^0.3.23",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"tailwindcss": ">=4.0.0"
	},
	"engines": {
		"node": ">=22"
	}
}
